# Alpaca Markets API
# Sign up at https://alpaca.markets and get paper trading keys first
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# Set to "paper" for paper trading (safe default), "live" for real money
ALPACA_MODE=paper

# Anthropic API (Claude AI for market analysis and RCA)
# Sign up at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Reddit API (for social sentiment - create app at https://reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=prosperity-trader/1.0

# NewsAPI (optional - free tier at https://newsapi.org)
NEWS_API_KEY=your_newsapi_key_here

# Finnhub (optional - free tier at https://finnhub.io)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Notification settings (optional - for trade alerts)
NOTIFY_EMAIL=your_email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Trading parameters
STARTING_CAPITAL=20.00
TARGET_CAPITAL=100.00
# Max % of portfolio per trade (0.90 = 90% all-in since small account)
MAX_POSITION_SIZE=0.90
# Stop loss percentage below entry
STOP_LOSS_PCT=0.03
# Take profit percentage above entry
TAKE_PROFIT_PCT=0.08
# Max trades per day
MAX_DAILY_TRADES=3
# Enable crypto trading (no PDT rules, 24/7)
ENABLE_CRYPTO=true
# Enable stock trading
ENABLE_STOCKS=true
